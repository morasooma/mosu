<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Label="Nuget">
    <Title>osu!</Title>
    <PackageId>ppy.osu.Game</PackageId>
    <Version>0.0.0</Version>
    <PackageIcon>icon.png</PackageIcon>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup Label="Icon">
    <None Include="..\assets\morasooma.png">
      <Pack>True</Pack>
      <PackagePath>icon.png</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup Label="Package References">
    <PackageReference Include="DiffPlex" Version="1.9.0"/>
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1"/>
    <PackageReference Include="Humanizer" Version="3.0.10"/>
    <PackageReference Include="MaterialColorUtilities" Version="0.3.0"/>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0"/>
    <PackageReference Include="MaterialTheming" Version="2.4.0"/>
    <PackageReference Include="MessagePack" Version="3.1.12"/>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14"/>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.14"/>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.NewtonsoftJson" Version="10.0.14"/>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.14"/>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.23.2"/>
    <PackageReference Include="Razorvine.Pickle" Version="1.5.0"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14"/>
    <PackageReference Include="Microsoft.Toolkit.HighPerformance" Version="7.1.2"/>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
    <PackageReference Include="ppy.LocalisationAnalyser" Version="2026.611.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Realm" Version="20.1.0"/>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Sentry" Version="6.12.1"/>
    <PackageReference Include="SharpCompress" Version="0.50.7"/>
    <PackageReference Include="NUnit" Version="4.6.1"/>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5"/>
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0"/>
    <PackageReference Include="TagLibSharp" Version="2.3.0"/>
  </ItemGroup>
  <!-- Raw history stays on disk. Do not package restored stable graphics or
       original recordings underneath the accepted replacement stores. Personal
       pack notices remain inside their own archives, not this built-in bank. -->
  <ItemGroup>
    <EmbeddedResource Remove="Resources/InterfaceSounds/Lazer2017/**/*;Resources/Skins/**/*;Resources/Samples/**/*;Resources/CustomFonts/danc.fnt;Resources/CustomFonts/danc.png" />
  </ItemGroup>
  <ItemGroup Label="Mosu Source References">
    <ProjectReference Include="..\external\mosu-framework\osu.Framework\osu.Framework.csproj" />
    <PackageReference Include="ppy.osu.Game.Resources" Version="2026.918.0" />
    <ProjectReference Include="..\external\mosu-resources\Morasooma.Resources.csproj" />
  </ItemGroup>
</Project>
