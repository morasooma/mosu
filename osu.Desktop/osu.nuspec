<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
    <metadata>
        <id>morasooma</id>
        <version>0.0.0</version>
        <title>Morasooma</title>
        <authors>Morasooma contributors</authors>
        <owners>Morasooma contributors</owners>
        <projectUrl>https://github.com/GooGuTeam/osu</projectUrl>
        <icon>icon.png</icon>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <description>Morasooma — an independent rhythm game client based on MIT-licensed upstream code.</description>
        <releaseNotes>testing</releaseNotes>
        <copyright>Copyright (c) 2026 Morasooma contributors. Upstream portions copyright (c) ppy Pty Ltd.</copyright>
        <language>en-AU</language>
    </metadata>
    <files>
      <file src="**.exe" target="lib\net45\" exclude="**vshost**"/>
      <file src="**.dll" target="lib\net45\"/>
      <file src="**.config" target="lib\net45\"/>
      <file src="**.json" target="lib\net45\"/>
      <file src="**.ico" target="lib\net45\"/>
      <file src="icon.png" target=""/>
    </files>
</package>
