<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RuntimeIdentifier Condition="'$(OS)' != 'Windows_NT' and '$(RuntimeIdentifier)' == '' and '$([MSBuild]::IsOSPlatform(&quot;Linux&quot;))'">linux-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier.Substring($([MSBuild]::Add($(RuntimeIdentifier.LastIndexOf('-')), 1))))</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == ''">x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Morasooma — an independent rhythm game client.</Description>
    <AssemblyName>Morasooma</AssemblyName>
    <AssemblyTitle>Morasooma</AssemblyTitle>
    <Title>Morasooma</Title>
    <Product>Morasooma</Product>
    <ApplicationIcon>lazer.ico</ApplicationIcon>
    <Version>0.0.0</Version>
    <FileVersion>0.0.0</FileVersion>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>
  <PropertyGroup Label="Auto Versioning" Condition="'$(Configuration)' == 'Release' and '$(Version)' == '0.0.0'">
    <AutoVersionYear>$([System.DateTime]::UtcNow.Year)</AutoVersionYear>
    <AutoVersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</AutoVersionDayOfYear>
    <AutoVersionPatch>0</AutoVersionPatch>
    <Version>$(AutoVersionYear).$(AutoVersionDayOfYear).$(AutoVersionPatch)-morasooma</Version>
    <FileVersion>$(AutoVersionYear).$(AutoVersionDayOfYear).$(AutoVersionPatch).0</FileVersion>
    <AssemblyVersion>$(AutoVersionYear).$(AutoVersionDayOfYear).$(AutoVersionPatch).0</AssemblyVersion>
    <InformationalVersion>$(Version)+local.$([System.DateTime]::UtcNow.ToString('yyyyMMddHHmmss'))</InformationalVersion>
  </PropertyGroup>

  <!-- Required for deployment. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <StartupHookSupport>false</StartupHookSupport>
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <PropertyGroup>
    <StartupObject>osu.Desktop.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\osu.Game.Tournament\osu.Game.Tournament.csproj"/>
    <ProjectReference Include="..\osu.Game\osu.Game.csproj"/>
    <ProjectReference Include="..\osu.Game.Rulesets.Osu\osu.Game.Rulesets.Osu.csproj"/>
    <ProjectReference Include="..\osu.Game.Rulesets.Catch\osu.Game.Rulesets.Catch.csproj"/>
    <ProjectReference Include="..\osu.Game.Rulesets.Mania\osu.Game.Rulesets.Mania.csproj"/>
    <ProjectReference Include="..\osu.Game.Rulesets.Taiko\osu.Game.Rulesets.Taiko.csproj"/>
    <ProjectReference Include="..\osu.Game.Rulesets.Dodge\osu.Game.Rulesets.Dodge.csproj" />
  </ItemGroup>
  <ItemGroup Label="Package References">
    <PackageReference Include="System.IO.Packaging" Version="10.0.12"/>
    <!-- Held back due to invite bug in newer versions. See https://github.com/Lachee/discord-rpc-csharp/issues/286 -->
    <PackageReference Include="DiscordRichPresence" Version="1.5.0.51"/>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.745401"/>
    <PackageReference Include="Velopack" Version="1.2.0"/>
  </ItemGroup>
  <ItemGroup Label="Resources">
    <EmbeddedResource Include="lazer.ico"/>
  </ItemGroup>
  <ItemGroup Label="Performance Diagnostics">
    <Content Include="mosu-performance-benchmark.osr" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Label="Windows Icons">
    <Content Include="*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
