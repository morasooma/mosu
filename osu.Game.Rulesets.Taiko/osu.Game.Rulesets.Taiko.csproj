<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>bash the drum. to the beat.</Description>
  </PropertyGroup>

  <PropertyGroup Label="Nuget">
    <Title>Morasooma Taiko ruleset</Title>
    <PackageId>ppy.osu.Game.Rulesets.Taiko</PackageId>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- Use the accepted ruleset-specific recordings, not shadowed originals.
       Keep raw audio on disk and preserve conversion fixtures separately. -->
  <ItemGroup>
    <EmbeddedResource Remove="Resources/Samples/**/*" />
  </ItemGroup>

  <ItemGroup Label="Project References">
    <ProjectReference Include="..\osu.Game\osu.Game.csproj" />
  </ItemGroup>
</Project>
